# ─── GROQ ───────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Vision-capable model on Groq. Check https://console.groq.com/docs/models
# if this is deprecated — it is a config value here so the swap is one line.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3001

# ─── BIOMETRIC THRESHOLDS ────────────────────────────────────────────────────
# Cosine similarity (0-1 scale). Raw MobileNet embeddings compared directly.
MATCH_THRESHOLD=0.72
MARGIN_THRESHOLD=0.06
